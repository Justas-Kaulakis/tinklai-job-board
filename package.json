{
    "name": "auth-nextjs",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "db:migrate": "dotenv -e .env.development  -- npx prisma migrate dev",
        "db:generate": "dotenv -e .env.development -- npx prisma generate",
        "db:studio": "dotenv -e .env.development  -- npx prisma studio",
        "db:reset": "dotenv -e .env.development  -- npx prisma migrate reset",
        "db:seed": "dotenv -e .env.development -- npx prisma db seed",
        "db:migrate-deploy": "npx prisma migrate deploy"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.0",
        "@prisma/adapter-better-sqlite3": "^6.17.1",
        "@prisma/adapter-pg": "^6.19.0",
        "@prisma/client": "^6.17.0",
        "@radix-ui/react-slot": "^1.1.1",
        "bcryptjs": "^3.0.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "dotenv-cli": "^10.0.0",
        "lucide-react": "^0.469.0",
        "next": "^15.5.4",
        "next-auth": "^5.0.0-beta.29",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sharp": "^0.34.4",
        "sonner": "^2.0.7",
        "tailwind-merge": "^2.6.0",
        "tailwindcss-animate": "^1.0.7",
        "uuid": "^13.0.0",
        "zod": "^4.1.12"
