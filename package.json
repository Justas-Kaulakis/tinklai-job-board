        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "15.1.3",
        "postcss": "^8",
        "prisma": "^6.17.0",
        "tailwindcss": "^3.4.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.6",
        "typescript": "^5"
    }
