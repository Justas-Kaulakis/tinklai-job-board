generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String? @unique
  password String?
  image    String?

  // RBAC
  role    String  @default("CLIENT") // "CLIENT" | "CONTROLLER" | "ADMIN"
  canPost Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  posts        JobPost[]
  sentMessages Message[] @relation("UserSentMessages")

  @@index([role])
}

model JobPost {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String // "OFFER" | "WANTED" (kept as TEXT for SQLite)
  image       String?
  views       Int      @default(0)
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  messages Message[] @relation("PostMessages")

  @@index([category, expiresAt])
  @@index([authorId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  // Belongs to one post (receiver is implied by post.authorId)
  postId String
  post   JobPost @relation("PostMessages", fields: [postId], references: [id], onDelete: Cascade)

  // Sender (the user who wrote the message)
  senderId String
  sender   User   @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([senderId])
}
